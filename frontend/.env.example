# Duas origens de API, e elas NÃO são intercambiáveis.
#
# Usar a errada é o bug mais provável deste projeto: ele não aparece rodando o
# Next fora do Docker, só dentro do Compose. Todo fetch passa por lib/api.ts,
# que escolhe a base conforme o contexto de execução.

# Server Components, Route Handlers e middleware rodam DENTRO da rede do
# Compose. Resolvem o backend pelo nome do serviço, não pelo host.
API_URL_INTERNAL=http://backend

# Código que executa no browser não enxerga a rede do Compose: resolve pela
# porta publicada no host.
NEXT_PUBLIC_API_URL=http://localhost:8000
